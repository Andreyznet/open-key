# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where Open-Key is hosted (e.g. https://open-key.ru).
APP_URL="https://open-key.ru"

# PORT: HTTP port for the Express server (default 3000)
PORT="3000"

# YOOKASSA_SHOP_ID & YOOKASSA_SECRET_KEY: Server-side credentials from YuKassa cabinet.
# Leave empty in local preview; set real values in .env on your VPS.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL=""

# Owner-only Admin Panel access control (comma-separated phones and personal subscriber IDs)
OWNER_PHONES="79128387309"
OWNER_SUBSCRIBER_IDS="1801607"

# AES-256-GCM encryption key for all server-side user data (.data/*).
# If left empty, the server auto-generates a 256-bit key in .data/.master.key.
DATA_ENCRYPTION_KEY=""

# Optional extra PIN for Admin Panel (leave empty to rely strictly on verified owner session)
ADMIN_PIN=""
